<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Sintet" Width="620" Height="510" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterScreen" FontFamily="SF Pro Display, SF Pro Text, SF Pro, Segoe UI" Foreground="#EDEDED" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#EDEDED"/><Setter Property="Background" Value="#282828"/><Setter Property="Padding" Value="18,11"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.6"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#B8B8B8"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="18" Height="18" CornerRadius="5" Background="#303030" Margin="0,0,10,0"><Path x:Name="Tick" Data="M3,8 L6.5,11.5 L13,5" Stroke="#181818" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/></Border><ContentPresenter VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#EDEDED"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border x:Name="Outer" CornerRadius="16" Background="#111111" BorderBrush="#292929" BorderThickness="1" ClipToBounds="True">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="68"/></Grid.RowDefinitions>
   <Grid x:Name="TitleRegion" Grid.Row="0" Margin="24,0,20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Width="25" Height="25" Stretch="Uniform" Fill="#F5F5F5" Data="F0 M0-210 121-143v105l-20 10v-90L12-69V43l111-61 49 26L0 108-172 8l49-26 111 61V-69l-89-49v90l-20-10v-105Z M0-187 86-141Q0-121-86-141Z M-259 76l81-43v29L0 157l178-95V33l81 43L0 210Z"/><TextBlock Text="Sintet" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="20" FontWeight="Medium"/></StackPanel><Button x:Name="CloseButton" Grid.Column="1" Content="×" Width="30" Height="30" Padding="0" FontSize="20" FontWeight="Normal" Background="#202020" Foreground="#999999"/></Grid>
   <Grid Grid.Row="1" x:Name="ContentHost" Margin="58,0,58,0">
    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
    <StackPanel x:Name="WelcomePanel" VerticalAlignment="Center">
     <TextBlock x:Name="WelcomeTitle" Text="Установка Sintet" FontSize="29" FontWeight="SemiBold" HorizontalAlignment="Center"/>
     <TextBlock x:Name="WelcomeSubtitle" Text="Выбери, где будет установлен лаунчер." Foreground="#999999" FontSize="14" Margin="0,8,0,24" HorizontalAlignment="Center" TextAlignment="Center"/>
     <StackPanel x:Name="InstallPathSection">
      <TextBlock x:Name="InstallPathLabel" Text="Папка установки" FontSize="13" Foreground="#AAAAAA" Margin="0,0,0,8"/>
      <Border x:Name="InstallPathCard" Background="#222222" CornerRadius="10" Padding="12,3,5,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="InstallPath" Background="Transparent" BorderThickness="0" Foreground="#D6D6D6" CaretBrush="White" SelectionBrush="#555555" FontSize="14" VerticalContentAlignment="Center" Padding="0,9"/><Button x:Name="BrowseButton" Grid.Column="1" Content="Обзор" Background="#303030" Padding="12,8" FontSize="12"/></Grid></Border>
      <TextBlock x:Name="SpaceHint" Text="Sintet и компоненты займут около 40 МБ" Foreground="#888888" FontSize="11" Margin="1,8,0,0"/>
      <Border x:Name="DependencyCard" Background="#1A1A1A" CornerRadius="10" Margin="0,16,0,15" Padding="14,12"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Microsoft WebView2" Foreground="#D2D2D2" FontSize="13"/><TextBlock x:Name="WebViewStatus" Grid.Column="1" Text="Проверяем…" Foreground="#A3A3A3" FontSize="12" VerticalAlignment="Center"/></Grid><TextBlock Text="Java установится вместе с выбранной версией Minecraft" Foreground="#909090" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
      <CheckBox x:Name="DesktopShortcut" Content="Создать ярлык на рабочем столе"/>
     </StackPanel>
     <StackPanel x:Name="RemoveDataSection" Visibility="Collapsed" Margin="0,4,0,0">
      <CheckBox x:Name="RemoveUserData" Content="Удалить Minecraft и все данные"/>
      <TextBlock x:Name="RemoveDataDetail" Text="" TextWrapping="Wrap" Foreground="#999999" FontSize="12" Margin="28,9,0,0" Visibility="Collapsed"/>
     </StackPanel>
     <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#D4D4D4" FontSize="12" Margin="0,10,0,0" TextAlignment="Center"/>
    </StackPanel>
    <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Stretch">
     <Grid Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,23"><Ellipse Stroke="#303030" StrokeThickness="3"/><Path x:Name="Spinner" Data="M24,2 A22,22 0 0 1 46,24" Stroke="#D2D2D2" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform/></Path.RenderTransform></Path></Grid>
     <TextBlock x:Name="ProgressTitle" Text="Устанавливаем Sintet" FontSize="25" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="ProgressDetail" Text="Подготавливаем файлы" Foreground="#999999" FontSize="14" Margin="0,10,0,25" TextWrapping="Wrap" TextAlignment="Center"/>
     <Grid x:Name="ProgressTrack" Height="4" ClipToBounds="True"><Border CornerRadius="3" Background="#303030"/><Border x:Name="ProgressFill" CornerRadius="3" Background="#C6C6C6" Width="0" HorizontalAlignment="Left"/></Grid>
     <Grid Margin="0,10,0,0"><TextBlock x:Name="ProgressNote" Text="Оставь это окно открытым" Foreground="#888888" FontSize="11"/><TextBlock x:Name="ProgressPercent" Text="0%" Foreground="#AAAAAA" FontSize="12" HorizontalAlignment="Right"/></Grid>
    </StackPanel>
    <StackPanel x:Name="FinishPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
     <Border Width="54" Height="54" CornerRadius="17" Background="#252525" HorizontalAlignment="Center" Margin="0,0,0,22"><Path Data="M14,27 L23,36 L41,18" Stroke="#E6E6E6" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Border>
     <TextBlock x:Name="FinishTitle" Text="Всё на месте" FontSize="27" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="FinishDetail" Text="Sintet готов к запуску." Foreground="#999999" FontSize="14" Margin="0,10,0,24" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
     <CheckBox x:Name="LaunchAfter" Content="Запустить Sintet" IsChecked="True" HorizontalAlignment="Center"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="2" Margin="24,0,24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FooterNote" Text="Для текущего пользователя" FontSize="11" Foreground="#888888" VerticalAlignment="Center"/><Button x:Name="PrimaryButton" Grid.Column="1" Content="Установить" Background="#EDEDED" Foreground="#171717" VerticalAlignment="Center" Height="40" MinWidth="116" Padding="16,0"/></Grid>
   <Border x:Name="DragRegion" Grid.Row="0" Height="58" VerticalAlignment="Top" Background="Transparent" Margin="55,0,60,0"/>
  </Grid>
 </Border>
</Window>
